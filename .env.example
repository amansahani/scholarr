# Scholarr AI Mentor Configuration
PORT=8080
DATABASE_URL=scholarr.db

# LLM Agnostic Configuration (Default: OpenRouter Free Models)
# Supported providers: openrouter, gemini, openai, groq, ollama, anthropic, custom

# 1. OpenRouter (Default Free Models: Laguna-S + Liquid LFM Embedding)
LLM_PROVIDER=openrouter
LLM_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=poolside/laguna-s-2.1:free
LLM_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free

# 2. Google Gemini Example
# LLM_PROVIDER=gemini
# LLM_API_KEY=your_gemini_api_key_here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
# LLM_EMBEDDING_MODEL=text-embedding-004

# 3. Groq Inference Example
# LLM_PROVIDER=groq
# LLM_API_KEY=your_groq_api_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1/
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free

# 4. Ollama (Local LLM) Example
# LLM_PROVIDER=ollama
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1/
# LLM_MODEL=llama3.2
# LLM_EMBEDDING_MODEL=nomic-embed-text
